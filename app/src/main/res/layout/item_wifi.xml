<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:padding="17dp"
android:background="#FFFFFF">
<TextView android:id="@+id/txtSsid" android:layout_width="0dp" android:layout_height="wrap_content"
android:textColor="#101828" android:textSize="17sp" android:textStyle="bold"
app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"/>
<TextView android:id="@+id/txtRssi" android:layout_width="wrap_content" android:layout_height="wrap_content"
android:layout_marginTop="7dp" android:textColor="#667085" android:textSize="14sp"
app:layout_constraintTop_toBottomOf="@id/txtSsid" app:layout_constraintStart_toStartOf="parent"/>
<TextView android:id="@+id/txtQuality" android:layout_width="wrap_content" android:layout_height="wrap_content"
android:textColor="#1565C0" android:textSize="14sp" android:textStyle="bold"
app:layout_constraintTop_toBottomOf="@id/txtSsid" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
